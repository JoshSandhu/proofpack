    "fairnessGap": {
      "type": "object",
      "description": "One level's gaps against the reference level: the diff_vs_reference cells re-read as gaps (fpr_gap is the mirrored specificity difference), the AUROC gap, the selection-rate gap labelled descriptive_not_target, and calibration-by-group as null with a typed reason until the calibration day. No status key: the comparison to the bound is E7's.",
      "required": [
        "level",
        "is_unknown_row",
        "n",
        "operating_points",
        "auroc_gap",
        "calibration"
      ],
      "additionalProperties": false,
      "properties": {

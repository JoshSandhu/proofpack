{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpack.io/schema/output_schema_v1.json",
  "title": "ProofPack output document v1",
  "description": "D1 section 4. The document the renderer consumes. Sections not yet produced by the engine (calibration, robustness, comparison, drift, claims) are declared here with their shape so the schema is stable, but are permitted to be null or absent until their build day lands. The subgroups, subgroup_attributes and fairness blocks landed on build day 5 (stats.subgroups).",
  "type": "object",
  "required": ["schema_version", "manifest", "declarations", "halts", "warnings", "flow"],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest": {
      "type": "object",
      "required": ["run_id", "engine_version", "python", "numpy", "seed", "started"],
      "properties": {
        "run_id": { "type": "string" },
        "engine_version": { "type": "string" },
        "platform": { "type": "string" },
        "python": { "type": "string" },
        "numpy": { "type": "string" },
        "scipy": { "type": ["string", "null"] },
        "input_sha256": { "type": ["string", "null"] },
        "criteria_sha256": { "type": ["string", "null"] },
        "mapping_sha256": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "B": { "type": ["integer", "null"] },
        "started": { "type": "string" },
        "duration_s": { "type": ["number", "null"] },
        "reference_platform": { "type": "boolean" },
        "licence_id": { "type": ["string", "null"] },
        "tier": { "type": ["string", "null"] },
        "ledger_count": { "type": ["integer", "null"] }
      }
    },
    "declarations": { "type": "object" },
    "halts": { "type": "array", "items": { "type": "object" } },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "text_id": { "type": ["string", "null"] },
          "params": { "type": "object" }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["rows_read", "analysed"],
      "properties": {
        "rows_read": { "type": "integer", "minimum": 0 },
        "excluded_missing_label": { "type": "integer", "minimum": 0 },
        "excluded_missing_score": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 },
        "analysed": { "type": "integer", "minimum": 0 },
        "n_cases": { "type": ["integer", "null"] },
        "clustered": { "type": "boolean" }
      }
    },
    "table1": { "type": ["object", "null"] },
    "overall": {
      "type": ["object", "null"],
      "description": "One key per declared operating point id, plus 'threshold_free'.",
      "properties": {
        "threshold_free": { "$ref": "#/$defs/thresholdFree" }
      },
      "additionalProperties": { "$ref": "#/$defs/operatingPointBlock" }
    },
    "calibration": { "type": ["object", "null"] },
    "subgroups": { "type": ["array", "null"], "items": { "$ref": "#/$defs/subgroupRow" } },
    "subgroup_attributes": {
      "type": ["array", "null"],
      "description": "Build day 5: one block per tabulated attribute (reference level, level order, heterogeneity footnote).",
      "items": { "$ref": "#/$defs/subgroupAttribute" }
    },
    "intersectional": { "type": ["array", "null"], "items": { "type": "object" } },
    "fairness": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fairnessBlock" }] },
    "robustness": { "type": ["object", "null"] },
    "comparison": { "type": ["object", "null"] },
    "drift": { "type": ["object", "null"] },
    "criteria_results": { "type": ["array", "null"], "items": { "type": "object" } },
    "claims": { "type": ["array", "null"], "items": { "type": "object" } },
    "suppression_log": { "type": ["array", "null"], "items": { "type": "object" } },
    "guidance_refs": { "type": ["array", "null"], "items": { "type": "object" } }
  },

  "$defs": {
    "metricId": {
      "enum": [
        "sensitivity", "specificity", "ppa", "npa", "ppv", "npv", "accuracy",
        "balanced_accuracy", "f1", "mcc", "lr_pos", "lr_neg", "dor", "youden",
        "auroc", "auprc", "brier", "ipa", "oe", "calibration_slope",
        "calibration_intercept", "ece", "tpr_gap", "fpr_gap", "ppv_gap", "npv_gap",
        "auroc_gap", "psi", "ks_d", "prevalence",
        "kappa", "macro_auroc", "bias", "loa_low", "loa_high", "mae", "rmse", "ccc",
        "dice_mean", "dice_median"
      ]
    },
    "method": {
      "description": "D1 section 4.1 enum. 'logit_delta' and 'newcombe11' were added on build day 2 (see handoffs/2026-09-08_E.md).",
      "enum": [
        "wilson", "wilson_cc", "clopper_pearson", "newcombe10", "newcombe11",
        "newcombe_paired", "delong_logit", "delong_wald",
        "cluster_bootstrap_percentile", "bootstrap_percentile", "bootstrap_bca",
        "irls_wald", "log_delta", "logit_delta", "chi2_psi", "exact_mcnemar",
        "cc_mcnemar", "none"
      ]
    },
    "notEstimableReason": {
      "description": "Typed reasons a quantity carries no interval. There is no untyped fallback. 'cases_span_both_groups' and 'insufficient_levels' were added on build day 5 (stats.subgroups).",
      "enum": [
        "zero_denominator", "single_class", "insufficient_positives",
        "insufficient_negatives", "zero_cell_log_undefined",
        "zero_cell_logit_undefined", "boundary_estimate",
        "analytic_ci_unavailable", "clustered_data_analytic_ci_invalid",
        "scipy_unavailable", "not_computed_this_run",
        "insufficient_clusters", "degenerate_resamples",
        "cases_span_both_groups", "insufficient_levels"
      ]
    },
    "flag": {
      "description": "Advisory annotations. The three added on build day 4 record the X2 clustered auto-switch and the small-class switch on the Number that is rendered; the typed reason itself rides on the companion analytic Number. 'newcombe_refused_clustered' (build day 5) rides on a subgroup difference computed by the two-sided cluster bootstrap because Newcombe method 10 was refused on clustered rows.",
      "enum": [
        "not_evaluable_shown_for_transparency", "very_low_precision", "imprecise",
        "wald_interval_exceeds_unit_range", "ci_pending_bootstrap",
        "continuity_corrected", "shown_alongside_wilson_at_boundary",
        "delong_refused_clustered", "wilson_refused_clustered", "newcombe_refused_clustered",
        "analytic_ci_replaced_small_class"
      ]
    },

    "Number": {
      "type": "object",
      "description": "Every rendered quantity (D1 section 4.1). Invariant: a Number either carries both interval bounds, or is suppressed, or names a typed not_estimable_reason. It is never possible to render an estimate whose uncertainty is unstated.",
      "required": ["est", "ci_lo", "ci_hi", "ci_level", "method", "flags", "suppressed", "not_estimable_reason"],
      "additionalProperties": false,
      "properties": {
        "est": { "type": ["number", "null"] },
        "ci_lo": { "type": ["number", "null"] },
        "ci_hi": { "type": ["number", "null"] },
        "ci_level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "method": { "$ref": "#/$defs/method" },
        "n": { "type": "integer", "minimum": 0 },
        "k": { "type": "integer", "minimum": 0 },
        "n_pos": { "type": "integer", "minimum": 0 },
        "n_neg": { "type": "integer", "minimum": 0 },
        "n_cases": { "type": "integer", "minimum": 0 },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
        "suppressed": { "type": "boolean" },
        "not_estimable_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/notEstimableReason" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "suppressed": { "const": true } }, "required": ["suppressed"] },
          "then": {
            "properties": {
              "est": { "type": "null" },
              "ci_lo": { "type": "null" },
              "ci_hi": { "type": "null" }
            }
          }
        },
        {
          "description": "No Number without a CI: if either bound is null and it is not suppressed, a typed reason is mandatory and the method must be 'none'.",
          "if": {
            "properties": {
              "suppressed": { "const": false },
              "ci_lo": { "type": "null" }
            },
            "required": ["suppressed", "ci_lo"]
          },
          "then": {
            "properties": {
              "ci_hi": { "type": "null" },
              "method": { "const": "none" },
              "not_estimable_reason": { "$ref": "#/$defs/notEstimableReason" }
            },
            "required": ["not_estimable_reason"]
          }
        },
        {
          "description": "A Number with an interval names a real method and carries no reason.",
          "if": {
            "properties": { "ci_lo": { "type": "number" } },
            "required": ["ci_lo"]
          },
          "then": {
            "properties": {
              "ci_hi": { "type": "number" },
              "method": { "not": { "const": "none" } },
              "not_estimable_reason": { "type": "null" }
            }
          }
        }
      ]
    },

    "twoByTwo": {
      "type": "object",
      "required": ["tp", "fn", "fp", "tn"],
      "additionalProperties": false,
      "properties": {
        "tp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "tn": { "type": "integer", "minimum": 0 }
      }
    },

    "operatingPointBlock": {
      "type": "object",
      "description": "Threshold metrics at one operating point. Exactly one of sensitivity/ppa and one of specificity/npa is present: PPA/NPA when the reference standard is a non-reference comparator (FDA 2007), and then the words sensitivity/specificity must not appear.",
      "required": ["two_by_two"],
      "properties": {
        "two_by_two": { "$ref": "#/$defs/twoByTwo" },
        "sensitivity": { "$ref": "#/$defs/Number" },
        "specificity": { "$ref": "#/$defs/Number" },
        "ppa": { "$ref": "#/$defs/Number" },
        "npa": { "$ref": "#/$defs/Number" },
        "ppv": { "$ref": "#/$defs/Number" },
        "npv": { "$ref": "#/$defs/Number" },
        "accuracy": { "$ref": "#/$defs/Number" },
        "balanced_accuracy": { "$ref": "#/$defs/Number" },
        "f1": { "$ref": "#/$defs/Number" },
        "mcc": { "$ref": "#/$defs/Number" },
        "lr_pos": { "$ref": "#/$defs/Number" },
        "lr_neg": { "$ref": "#/$defs/Number" },
        "dor": { "$ref": "#/$defs/Number" },
        "youden": { "$ref": "#/$defs/Number" },
        "prevalence": { "$ref": "#/$defs/Number" },
        "ppv_at_prevalence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value", "ppv", "npv"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "ppv": { "$ref": "#/$defs/Number" },
              "npv": { "$ref": "#/$defs/Number" }
            }
          }
        },
        "indeterminate_as_positive": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/operatingPointBlock" }]
        },
        "indeterminate_as_negative": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/operatingPointBlock" }]
        },
        "n_indeterminate_reference_positive": { "type": "integer", "minimum": 0 },
        "n_indeterminate_reference_negative": { "type": "integer", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["sensitivity", "specificity"], "not": { "anyOf": [{ "required": ["ppa"] }, { "required": ["npa"] }] } },
        { "required": ["ppa", "npa"], "not": { "anyOf": [{ "required": ["sensitivity"] }, { "required": ["specificity"] }] } }
      ]
    },

    "thresholdFree": {
      "type": "object",
      "required": ["auroc", "prevalence"],
      "properties": {
        "auroc": { "$ref": "#/$defs/Number" },
        "auroc_wald": {
          "description": "Secondary Wald interval, shown beside the logit interval (R2 section 1.3).",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Number" }]
        },
        "auprc": {
          "description": "Deferred to v1.1; always null in v1.",
          "type": "null"
        },
        "prevalence": { "$ref": "#/$defs/Number" },
        "roc": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
            "minItems": 3,
            "maxItems": 3
          }
        },
        "roc_operating_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "threshold", "fpr", "tpr"],
            "properties": {
              "id": { "type": "string" },
              "threshold": { "type": "number" },
              "fpr": { "type": "number" },
              "tpr": { "type": "number" }
            }
          }
        },
        "pr": { "type": ["array", "null"] },
        "paired_comparison": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["auroc_a", "auroc_b", "difference", "z", "p_value", "method"],
              "properties": {
                "auroc_a": { "$ref": "#/$defs/Number" },
                "auroc_b": { "$ref": "#/$defs/Number" },
                "difference": { "$ref": "#/$defs/Number" },
                "variance_difference": { "type": "number" },
                "z": { "type": "number" },
                "p_value": { "type": "number" },
                "method": { "const": "paired_delong" }
              }
            }
          ]
        }
      }
    },

    "Cell": {
      "type": "object",
      "description": "One rendered quantity with its audit trail (build day 4 CellCI.as_dict, D1 section 9): the Number the renderer prints, the companion analytic Number (a typed refusal under clustering, or the same Number when the analytic method was used), what became of the analytic method, the clustering route, and the bootstrap block (policy, usable resamples, the resampling quantities the refusal rule was measured on) when a resampler ran. 'detail' carries statistics that are not Numbers and never verdicts (z, p_value, variances for an AUROC difference; the declared score type for a Brier that was not computed).",
      "required": [
        "number",
        "analytic",
        "analytic_status",
        "clustering_route",
        "bootstrap"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "$ref": "#/$defs/Number"
        },
        "analytic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Number"
            }
          ]
        },
        "analytic_status": {
          "enum": [
            "used",
            "refused_clustered",
            "replaced_small_class",
            "unavailable"
          ]
        },
        "clustering_route": {
          "enum": [
            "none",
            "declared",
            "detected"
          ]
        },
        "bootstrap": {
          "type": [
            "object",
            "null"
          ]
        },
        "detail": {
          "type": "object"
        },
        "label": {
          "type": "string",
          "description": "The selection-rate gap carries 'descriptive_not_target' (R2 section 4)."
        }
      }
    },
    "nullableCell": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Cell"
        }
      ]
    },
    "subgroupOperatingPointMetrics": {
      "type": "object",
      "description": "Per operating point inside a subgroup row: the 2x2 counts and every proportion metric as a Cell. Exactly one of sensitivity/ppa and one of specificity/npa is present (FDA 2007 routing).",
      "required": [
        "two_by_two",
        "ppv",
        "npv",
        "accuracy",
        "selection_rate"
      ],
      "properties": {
        "two_by_two": {
          "$ref": "#/$defs/twoByTwo"
        },
        "sensitivity": {
          "$ref": "#/$defs/Cell"
        },
        "specificity": {
          "$ref": "#/$defs/Cell"
        },
        "ppa": {
          "$ref": "#/$defs/Cell"
        },
        "npa": {
          "$ref": "#/$defs/Cell"
        },
        "ppv": {
          "$ref": "#/$defs/Cell"
        },
        "npv": {
          "$ref": "#/$defs/Cell"
        },
        "accuracy": {
          "$ref": "#/$defs/Cell"
        },
        "selection_rate": {
          "$ref": "#/$defs/Cell"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "sensitivity",
            "specificity"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ppa"
                ]
              },
              {
                "required": [
                  "npa"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "ppa",
            "npa"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sensitivity"
                ]
              },
              {
                "required": [
                  "specificity"
                ]
              }
            ]
          }
        }
      ]
    },
    "subgroupOperatingPointDifferences": {
      "type": "object",
      "description": "Per operating point: the level-minus-other difference of each proportion metric (Newcombe method 10, or the two-sided cluster bootstrap, or a typed refusal). Every value is null on the reference row's own diff_vs_reference.",
      "required": [
        "ppv",
        "npv",
        "accuracy",
        "selection_rate"
      ],
      "properties": {
        "sensitivity": {
          "$ref": "#/$defs/nullableCell"
        },
        "specificity": {
          "$ref": "#/$defs/nullableCell"
        },
        "ppa": {
          "$ref": "#/$defs/nullableCell"
        },
        "npa": {
          "$ref": "#/$defs/nullableCell"
        },
        "ppv": {
          "$ref": "#/$defs/nullableCell"
        },
        "npv": {
          "$ref": "#/$defs/nullableCell"
        },
        "accuracy": {
          "$ref": "#/$defs/nullableCell"
        },
        "selection_rate": {
          "$ref": "#/$defs/nullableCell"
        }
      },
      "additionalProperties": false
    },
    "subgroupDifferences": {
      "type": "object",
      "description": "diff_vs_reference / diff_vs_complement: one key per operating point id plus 'auroc'. There is no diff_vs_overall anywhere (objection X1: the subgroup is part of the overall cohort).",
      "required": [
        "auroc"
      ],
      "properties": {
        "auroc": {
          "$ref": "#/$defs/nullableCell"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/subgroupOperatingPointDifferences"
      }
    },
    "subgroupRow": {
      "type": "object",
      "description": "One level of one attribute (D1 section 4.2 'subgroups'; D4 section 5.3 row shape). is_unknown_row marks the explicit Unknown/missing row, which is never the reference. tier is the R2 section 3.3 precision tier measured in resampling units, or null.",
      "required": [
        "attribute",
        "level",
        "prespecified",
        "source",
        "is_reference",
        "is_unknown_row",
        "n",
        "events",
        "n_units",
        "event_units",
        "tier",
        "metrics",
        "diff_vs_reference",
        "diff_vs_complement"
      ],
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "prespecified": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "is_reference": {
          "type": "boolean"
        },
        "is_unknown_row": {
          "type": "boolean"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "n_units": {
          "type": "integer",
          "minimum": 0
        },
        "event_units": {
          "type": "integer",
          "minimum": 0
        },
        "tier": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "not_evaluable_shown_for_transparency",
                "very_low_precision"
              ]
            }
          ]
        },
        "metrics": {
          "type": "object",
          "required": [
            "auroc",
            "brier"
          ],
          "properties": {
            "auroc": {
              "$ref": "#/$defs/Cell"
            },
            "brier": {
              "$ref": "#/$defs/Cell"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/subgroupOperatingPointMetrics"
          }
        },
        "diff_vs_reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/subgroupDifferences"
            }
          ]
        },
        "diff_vs_complement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/subgroupDifferences"
            }
          ]
        }
      }
    },
    "heterogeneityTest": {
      "type": "object",
      "description": "One exploratory homogeneity test (R2 section 3.4). Raw and Holm-adjusted p-values are detail, never a criterion: this object has no 'status' key and a test asserts it.",
      "required": [
        "operating_point",
        "metric",
        "test",
        "statistic",
        "df",
        "p_raw",
        "p_holm",
        "n_levels",
        "min_expected",
        "not_estimable_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "operating_point": {
          "type": "string"
        },
        "metric": {
          "enum": [
            "sensitivity",
            "specificity",
            "ppa",
            "npa"
          ]
        },
        "test": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "chi2_homogeneity",
                "fisher_exact"
              ]
            }
          ]
        },
        "statistic": {
          "type": [
            "number",
            "null"
          ]
        },
        "df": {
          "type": [
            "integer",
            "null"
          ]
        },
        "p_raw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_holm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_levels": {
          "type": "integer",
          "minimum": 0
        },
        "min_expected": {
          "type": [
            "number",
            "null"
          ]
        },
        "not_estimable_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/notEstimableReason"
            }
          ]
        }
      }
    },
    "subgroupAttribute": {
      "type": "object",
      "description": "Per-attribute block: the reference level and how it was chosen, the level order, the age bands and their source, the complement definition, and the exploratory heterogeneity footnote.",
      "required": [
        "attribute",
        "prespecified",
        "source",
        "declared",
        "reference_level",
        "reference_rule",
        "level_order",
        "has_unknown_row",
        "n_unknown_missing",
        "n_outside_bands",
        "bands",
        "bands_source",
        "complement_definition",

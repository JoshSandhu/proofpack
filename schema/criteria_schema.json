{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpack.globalphoenix.co.uk/schema/criteria_schema.json",
  "title": "ProofPack criteria.yaml schema v1",
  "description": "Customer-authored declarations. The engine never supplies defaults: every value here is the manufacturer's. Prose source: D1 section 2. Missing MANDATORY block -> H08; unknown metric/operating point/attribute/level reference -> H09.",
  "type": "object",
  "$defs": {
    "authored": {
      "type": "object",
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "date": { "type": ["string"], "minLength": 1, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "justification": { "type": "string", "minLength": 1 }
      },
      "required": ["author", "date", "justification"]
    },
    "metric_id": {
      "type": "string",
      "enum": [
        "sensitivity", "specificity", "ppa", "npa", "ppv", "npv", "accuracy", "balanced_accuracy",
        "f1", "mcc", "lr_pos", "lr_neg", "dor", "youden", "auroc", "auprc", "brier", "ipa", "oe",
        "calibration_slope", "calibration_intercept", "ece", "tpr_gap", "fpr_gap", "ppv_gap",
        "npv_gap", "auroc_gap", "psi", "ks_d", "prevalence",
        "kappa", "macro_auroc", "bias", "loa_low", "loa_high", "mae", "rmse", "ccc", "dice_mean", "dice_median"
      ]
    },
    "label_value": { "type": ["string", "integer"] },
    "operating_point": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "rule": { "type": "string", "enum": [">=", ">", "<=", "<"] },
        "provenance": { "type": "string", "enum": ["prespecified_sap", "derived_from_this_dataset", "other"] },
        "source": { "type": "string" }
      },
      "required": ["id", "threshold", "rule", "provenance"]
    },
    "prevalence_entry": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "source": { "type": "string" }
      },
      "required": ["label", "value"]
    },
    "subgroup_decl": {
      "type": "object",
      "properties": {
        "attribute": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "prespecified": { "type": "boolean" },
        "source": { "type": "string" },
        "reference_level": { "type": ["string", "integer", "number"] },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
      },
      "required": ["attribute", "prespecified"]
    },
    "scope": {
      "oneOf": [
        { "type": "string", "const": "overall" },
        {
          "type": "object",
          "properties": {
            "attribute": { "type": "string" },
            "level": { "type": ["string", "integer", "number"] }
          },
          "required": ["attribute", "level"]
        }
      ]
    },
    "criterion": {
      "allOf": [
        { "$ref": "#/$defs/authored" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "metric": { "type": "string", "minLength": 1, "description": "Checked against $defs/metric_id by io.declare; an unknown id is gate H09, not a schema error." },
            "type": { "type": "string", "enum": ["point", "paired_difference_vs_prior"] },
            "operating_point": { "type": "string" },
            "scope": { "$ref": "#/$defs/scope" },
            "statistic": { "type": "string", "enum": ["ci_lower_bound", "point_estimate"] },
            "comparator": { "type": "string", "enum": [">=", ">", "<=", "<"] },
            "value": { "type": "number" }
          },
          "required": ["id", "metric", "statistic", "comparator", "value"]
        }
      ]
    }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "model": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "number"] },
        "prior_version": { "type": ["string", "number", "null"] },
        "udi_di": { "type": ["string", "null"] }
      },
      "required": ["name", "version"]
    },
    "task": { "type": "string", "enum": ["binary", "multiclass", "regression", "segmentation_ingest"] },
    "classes": {
      "type": "object",
      "description": "MANDATORY. Positive class is declared, never inferred.",
      "properties": {
        "positive": { "$ref": "#/$defs/label_value" },
        "negative": { "$ref": "#/$defs/label_value" }
      },
      "required": ["positive", "negative"]
    },
    "score": {
      "type": "object",
      "description": "MANDATORY. Orientation is declared, never inferred.",
      "properties": {
        "type": { "type": "string", "enum": ["probability", "logit", "other"] },
        "orientation": { "type": "string", "enum": ["higher_is_positive", "lower_is_positive"] }
      },
      "required": ["type", "orientation"]
    },
    "operating_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operating_point" }
    },
    "reference_standard": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["reference_standard", "comparator"] },
        "description": { "type": "string" }
      },
      "required": ["type"]
    },
    "indeterminates": {
      "type": "object",
      "properties": {
        "policy": { "type": "string", "enum": ["report_both_ways", "none_present"] },
        "values": { "type": "array", "items": { "$ref": "#/$defs/label_value" } }
      },
      "required": ["policy"]
    },
    "clustering": {
      "type": "object",
      "properties": {
        "unit": { "type": "string", "enum": ["none", "case_id"] },
        "declared_by": { "type": "string" }
      },
      "required": ["unit"]
    },
    "prevalence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prevalence_entry" }
    },
    "subgroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/subgroup_decl" }
    },
    "criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "fairness": {
      "allOf": [
        { "$ref": "#/$defs/authored" },
        {
          "type": "object",
          "properties": {
            "criterion_of_interest": {
              "type": "string",
              "enum": ["tpr_gap", "fpr_gap", "ppv_gap", "npv_gap", "auroc_gap", "calibration_by_group"]
            },
            "attribute": { "type": "string" },
            "bound": { "type": ["number", "null"] }
          },
          "required": ["criterion_of_interest", "attribute"]
        }
      ]
    },
    "ledger": {
      "type": "object",
      "properties": { "warn_after_acceptance_runs": { "type": "integer", "minimum": 1 } },
      "required": ["warn_after_acceptance_runs"]
    },
    "period": {
      "type": "object",
      "properties": {
        "column": { "type": "string" },
        "granularity": { "type": "string", "enum": ["quarter", "month", "year"] }
      },
      "required": ["column", "granularity"]
    },
    "egress": {
      "type": "object",
      "properties": {
        "telemetry": { "type": "boolean" },
        "suppression": {
          "type": "object",
          "description": "Defaults min_n 10 / min_events 5 / min_nonevents 5; the customer may only make these stricter.",
          "properties": {
            "min_n": { "type": "integer", "minimum": 10 },
            "min_events": { "type": "integer", "minimum": 5 },
            "min_nonevents": { "type": "integer", "minimum": 5 }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. Engine defaults: B 2000, seed 20240101, percentile intervals. The seed and B are recorded in the manifest together with whether they were declared or defaulted.",
      "properties": {
        "B": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0,
          "description": "Non-negative: numpy's Generator refuses a negative seed, and it would do so half way through a run rather than at declaration time." },
        "interval": {
          "type": "string",
          "description": "BCa is deferred to v1.1 (build day 4 decision). Declaring it fails validation here rather than silently yielding a percentile interval.",
          "enum": ["percentile"]
        }
      }
    }
  },
  "required": [
    "schema_version", "model", "task", "classes", "score", "operating_points",
    "reference_standard", "indeterminates", "clustering", "prevalence", "subgroups"
  ],
  "additionalProperties": false
}
